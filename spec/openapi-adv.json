    "/api/adv/update.json": {
      "post": {
        "operationId": "advUpdate",
        "summary": "Force next run now",
        "tags": [
          "Adv"
        ],
        "description": "Resets the integration's next-run time to now so the CRON scheduler picks it up on its next tick. Does not activate a disabled integration (status must be set separately via adv/edit). API-only capability, not wired into the UI. Error codes by HTTP status: 400 scope; 403 access; 404 no-id, not-found; 500 db.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Scope"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "adv"
                ],
                "properties": {
                  "adv": {
                    "type": "integer"
                  }
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New next-run timestamp.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "next": {
                          "type": "integer",
                          "description": "Unix timestamp, equals time of this call"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/adv/del.json": {
      "post": {
        "operationId": "advDel",
        "summary": "Delete ad-spend integration",
        "tags": [
          "Adv"
