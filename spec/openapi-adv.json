    "/api/adv/log.json": {
      "get": {
        "operationId": "advLog",
        "summary": "List integration request log",
        "tags": [
          "Adv"
        ],
        "description": "Reads the outbound-HTTP-request journal written whenever a connector makes a call. Error codes by HTTP status: 400 scope.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Scope"
          },
          {
            "$ref": "#/components/parameters/AdvId"
          },
          {
            "name": "error",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            },
            "description": "Applied only when present: truthy = errors only, present+falsy = successes only, absent = no filter"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "show",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "description": "0 = all rows"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated request log.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
