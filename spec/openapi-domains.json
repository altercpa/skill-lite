              "type": "integer"
            },
            "description": "File ID"
          },
          {
            "name": "file",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Alias for fid (tried second); numeric file ID, not a name alias"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "New file name. Allowed extensions: txt/js/json/htm/html/css/xml."
                  },
                  "data": {
                    "type": "string",
                    "description": "New file content. Trimmed and truncated to 3500 characters."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated file record.",
