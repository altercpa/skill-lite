        "tags": [
          "Domains",
          "Domain Files"
        ],
        "description": "Renames and/or rewrites the content of an existing confirmation file, identified directly by its numeric file ID (fid/file) — not by domain. A plain update, not an upsert: a rename colliding with another file of the same domain fails with bad-file. No billing check. Error codes by HTTP status: 400 no-name, bad-file; 404 not-found.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Scope"
          },
          {
