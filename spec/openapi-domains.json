    "/api/domains/dns.json": {
      "get": {
        "operationId": "domainsDns",
        "summary": "Parking IPs and DNS records for a domain",
        "tags": [
          "Domains"
        ],
        "description": "Returns the parking IP addresses and the ready DNS records to create at the registrar so that a domain points to the tracker. Read-only: no domain is added or changed; no billing check. The addresses depend on the parking setup of the user: a user who belongs to a team gets the addresses of the team setup. scope=gang uses the setup of the caller's own account; a user that is given must be a member of your team (otherwise the scope error) and does not change the result; scope=admin needs the user parameter. At most one A and one AAAA record are returned; with several addresses a random one is chosen on every call. Error codes by HTTP status: 400 scope, no-user.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Scope"
          },
          {
            "name": "user",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "scope=admin (required there): user whose parking addresses are returned. scope=gang: optional team member; a user outside your team is refused with the scope error, a valid one does not change the result"
          }
        ],
        "responses": {
          "200": {
            "description": "Parking addresses and DNS records.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "ips",
                        "records"
                      ],
                      "properties": {
                        "ips": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Parking IP addresses (IPv4 and IPv6); empty when none"
                        },
                        "records": {
                          "type": "array",
                          "description": "DNS records to create; empty when there are no addresses. At most one A and one AAAA record.",
                          "items": {
                            "type": "object",
                            "required": [
                              "name",
                              "type",
                              "value"
                            ],
                            "properties": {
                              "name": {
                                "type": "string",
                                "description": "Record name; always @ (the domain root)"
                              },
                              "type": {
                                "type": "string",
                                "enum": [
                                  "A",
                                  "AAAA"
                                ],
                                "description": "A for an IPv4 address, AAAA for an IPv6 address"
                              },
                              "value": {
                                "type": "string",
                                "description": "IP address the record points to"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "ok": {
                    "value": {
                      "status": "ok",
                      "data": {
                        "ips": [
                          "203.0.113.10",
                          "2001:db8::10"
                        ],
                        "records": [
                          {
                            "name": "@",
                            "type": "A",
                            "value": "203.0.113.10"
                          },
                          {
                            "name": "@",
                            "type": "AAAA",
                            "value": "2001:db8::10"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Domains",
      "description": "Parked domain management. not-found error covers both missing domains and access denied."
    },
    {
      "name": "Domain Files",
      "description": "Per-domain confirmation files served at the domain root (search-engine verification, ads.txt, etc.)."
    }
  ]
}
