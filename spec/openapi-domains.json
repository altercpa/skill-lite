    "/api/domains/confirm.json": {
      "post": {
        "operationId": "domainsConfirm",
        "summary": "Create or replace a domain confirmation file",
        "tags": [
          "Domains",
          "Domain Files"
        ],
        "description": "Creates a new confirmation file at the domain root, or silently overwrites an existing file of the same name on the same domain (upsert on domain + file name). Domain identified via the same uid/url/domain convention as check/del/glue. No billing check. File ownership is copied from the domain's current owner at creation time. Error codes by HTTP status: 400 no-name, bad-file; 404 not-found.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Scope"
          },
          {
            "name": "uid",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Domain ID"
          },
          {
            "name": "url",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Domain name"
          },
          {
            "name": "domain",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Domain name (alias for url)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "File name at domain root, e.g. ads.txt. Allowed extensions: txt/js/json/htm/html/css/xml (case-insensitive)."
                  },
                  "data": {
                    "type": "string",
                    "description": "File content. Trimmed and truncated to 3500 characters; empty content is allowed."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created/updated file record.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/DomainFile"
                    }
                  }
                },
                "example": {
                  "status": "ok",
                  "data": {
                    "id": 8,
                    "dom": 42,
                    "user": 0,
                    "gang": 3,
                    "name": "google1234567890.html",
                    "data": "google-site-verification: google1234567890.html"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/domains/change.json": {
      "post": {
        "operationId": "domainsChange",
