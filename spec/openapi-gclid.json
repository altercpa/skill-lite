{
  "openapi": "3.1.0",
  "info": {
    "title": "AlterCPA — Google Conversions Export API (gclid)",
    "version": "1.0.0",
    "description": "JSON CRUD API for the gclid hack — offline-conversion export documents (\"docs\") for Google Ads / GA4. A doc is a lead filter plus an export configuration; it exposes a live CSV export URL that Google fetches on a schedule to import offline conversions. The hack calls no Google API. Ownership is user XOR gang: a personal doc has user>0, gang=0; a team doc has user=0, gang>0. Authentication uses the id credential (id={user}-{key}); the doc identifier is passed in the doc parameter. Editing is partial. There is no active field — gclid has no activation. Clone resets the export progress (last and lead to 0) so the copy re-exports from scratch. Available on AlterCPA Lite and Pro; offers are a Pro-only filter. Success is HTTP 200; an error is answered with the HTTP status of its error code (400 generic, 401 key/auth, 402 unpaid, 403 access/ban, 404 no-id/bad-id/not-found, 500 app/func/db; bot answers 418) and repeated in the X-API-Status and X-API-Error headers."
  },
  "servers": [
    {
      "url": "https://{tracker}",
      "variables": {
        "tracker": {
          "default": "domain.com"
        }
      }
    }
  ],
  "security": [
    {
      "ApiToken": []
    }
  ],
  "tags": [
    {
      "name": "gclid",
      "description": "Google conversion-export document management"
    }
  ],
