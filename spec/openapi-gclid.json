            "schema": {
              "type": "string"
            },
            "description": "Filter by the exported lead field code"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "show",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 50
            },
            "description": "Records per page; 0 returns all without pagination"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of docs keyed by doc ID",
            "content": {
              "application/json": {
                "schema": {
