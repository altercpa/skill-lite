  "components": {
    "securitySchemes": {
      "ApiToken": {
        "type": "apiKey",
        "in": "query",
        "name": "id",
        "description": "Credential in the form {user}-{key}, e.g. 123-abcde"
      }
    },
    "parameters": {
      "Scope": {
        "name": "scope",
        "in": "query",
        "description": "Access scope; passed via GET only. A system (global) postback is addressed with scope=admin&user=0&gang=0.",
        "schema": {
          "type": "string",
          "enum": [
            "user",
            "gang",
            "team",
            "admin",
            "sys",
            "system",
            "all"
          ],
          "default": "user"
        }
      },
      "User": {
        "name": "user",
        "in": "query",
        "description": "Owner user ID for admin scope (0 for a system postback)",
        "schema": {
          "type": "integer"
        }
      },
      "Gang": {
        "name": "gang",
        "in": "query",
        "description": "Team ID for admin scope (0 for a system postback)",
        "schema": {
          "type": "integer"
        }
      },
      "Pb": {
        "name": "pb",
        "in": "query",
        "required": true,
        "description": "Numeric postback identifier",
        "schema": {
          "type": "integer"
        }
      }
    },
    "headers": {
      "XApiStatus": {
        "schema": {
          "type": "string",
          "enum": [
            "ok",
            "error"
          ]
        },
        "description": "Result status repeated from the body"
      },
      "XApiError": {
        "schema": {
          "type": "string"
        },
        "description": "Error code repeated from the body"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Function-level error (HTTP 400): scope, no-name, no-url, no-post, no-header, bad-filter; any error code not listed for another status.",
        "headers": {
          "X-API-Status": {
            "$ref": "#/components/headers/XApiStatus"
          },
          "X-API-Error": {
            "$ref": "#/components/headers/XApiError"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "status": "error",
              "error": "no-name"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Error key (API key missing or wrong) or auth.",
        "headers": {
          "X-API-Status": {
            "$ref": "#/components/headers/XApiStatus"
          },
          "X-API-Error": {
            "$ref": "#/components/headers/XApiError"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "status": "error",
              "error": "key"
            }
          }
        }
      },
      "PaymentRequired": {
        "description": "Error unpaid (active subscription required).",
        "headers": {
          "X-API-Status": {
            "$ref": "#/components/headers/XApiStatus"
          },
          "X-API-Error": {
            "$ref": "#/components/headers/XApiError"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "status": "error",
              "error": "unpaid"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Error ban (user banned or inactive) or access (postback outside the scope).",
        "headers": {
          "X-API-Status": {
            "$ref": "#/components/headers/XApiStatus"
          },
          "X-API-Error": {
            "$ref": "#/components/headers/XApiError"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "status": "error",
              "error": "ban"
            }
          }
        }
      },
      "NotFound": {
        "description": "no-id (pb missing), not-found (postback does not exist).",
        "headers": {
          "X-API-Status": {
            "$ref": "#/components/headers/XApiStatus"
          },
          "X-API-Error": {
            "$ref": "#/components/headers/XApiError"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "status": "error",
              "error": "not-found"
            }
          }
        }
      },
      "ServerError": {
        "description": "Error db (database failure); framework errors func/app.",
        "headers": {
          "X-API-Status": {
            "$ref": "#/components/headers/XApiStatus"
          },
          "X-API-Error": {
            "$ref": "#/components/headers/XApiError"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "status": "error",
              "error": "db"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "status",
          "error"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "error": {
            "type": "string",
            "description": "scope, no-name, no-url, no-post, no-header, bad-filter, no-id, not-found, access, db"
          }
        }
      },
      "Event": {
        "type": "object",
        "description": "Lead-status event descriptor",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
            "description": "Event index"
          },
          "key": {
            "type": "string",
            "enum": [
              "global",
              "new",
              "hold",
              "approve",
              "cancel",
              "trash"
            ],
            "description": "Event key (the add/edit flag name)"
          },
          "name": {
            "type": "string",
            "description": "Human-readable event name"
          }
        }
      },
      "Nav": {
        "type": "object",
