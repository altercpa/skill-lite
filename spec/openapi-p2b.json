{
  "openapi": "3.1.0",
  "info": {
    "title": "AlterCPA — Postback 2.0 API (p2b)",
    "version": "1.0.0",
    "description": "JSON CRUD API for the p2b hack — Postback 2.0, an outbound postback / notification engine. A postback is an automatic outbound HTTP call or Telegram message that fires when a lead changes state, filtered by an optional field/value and by the enabled status events (global/new/hold/approve/cancel/trash). Ownership is user, team or system: a personal postback has user>0, gang=0; a team postback has user=0, gang>0; a system (global) postback has user=0, gang=0 and is addressed with scope=admin&user=0&gang=0. For Telegram (type=1) the url is the bot token, header is the chat_id and post is the message text. Authentication uses the id credential (id={user}-{key}); the postback identifier is passed in the pb parameter. Editing is partial; activation is edit with the single active field. Available on AlterCPA Lite. Success is HTTP 200; an error is answered with the HTTP status of its error code (400 generic, 401 key/auth, 402 unpaid, 403 access/ban, 404 no-id/bad-id/not-found, 500 app/func/db; bot answers 418) and repeated in the X-API-Status and X-API-Error headers."
  },
  "servers": [
    {
      "url": "https://{tracker}",
      "variables": {
        "tracker": {
          "default": "domain.com"
        }
      }
    }
  ],
  "security": [
    {
      "ApiToken": []
    }
  ],
  "tags": [
    {
      "name": "p2b",
      "description": "Postback 2.0 management"
    }
  ],
  "paths": {
    "/api/p2b/list.json": {
      "get": {
        "operationId": "p2bList",
        "summary": "Postback list",
        "tags": [
          "p2b"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Scope"
          },
          {
            "$ref": "#/components/parameters/User"
          },
          {
            "$ref": "#/components/parameters/Gang"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Full-text search by postback name"
          },
          {
            "name": "filter",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by the tag (lead field code)"
          },
          {
            "name": "value",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by the filter value"
          },
          {
            "name": "event",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "description": "Filter by event index: 0 global, 1 new, 2 hold, 3 approve, 4 cancel, 5 trash"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            },
            "description": "Filter by send channel: 0 HTTP, 1 Telegram"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "show",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 50
            },
            "description": "Records per page; 0 returns all without pagination"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of postbacks keyed by postback ID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/PostbackShort"
                      }
                    },
                    "nav": {
                      "$ref": "#/components/schemas/Nav"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
